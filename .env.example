# CareerMate environment template
# Copy to .env.local and fill real values locally. Never commit .env.local.

DATABASE_URL="file:./dev.db"

TBOX_MODE="mock"
TBOX_API_KEY="placeholder"
TBOX_APP_ID="replace-with-app-id"
TBOX_AGENT_ID="replace-with-agent-id"
TBOX_DATASET_ROLE_COMPETENCY=""
TBOX_DATASET_LEARNING_RESOURCES=""
TBOX_DATASET_SIMULATION_SCENES=""
TBOX_DATASET_ETHICS_RULES=""
TBOX_DATASET_CAREER_TRENDS=""
TBOX_AGENT_VERSION=""
TBOX_SEARCH_ENGINE="false"
# Enable only after the isolated CareerMate职业成长伙伴V2 is published.
# When true, business_data contains only a scoped context token and page observations.
CAREERMATE_AGENTIC_V2="false"
TBOX_RETRIEVAL_MODE="agent"
# ── 百宝箱传输决策（安全默认值，只有真实探针通过后才能开启） ──
# history 传输模式：context_only（仅本地上下文）/ provider（百宝箱管理 history）
TBOX_HISTORY_MODE="context_only"
# 业务上下文传输：question_prefix（用户不可见前缀）/ business_data（JSON 字段）
TBOX_CONTEXT_TRANSPORT="question_prefix"
# 结构化输出：disabled（关闭）/ terminal（同轮返回）/ followup（第二次调用）
TBOX_STRUCTURED_MODE="disabled"
# 复用远端 conversation_id（当前未确认无效会话错误码，默认关闭）
TBOX_REUSE_REMOTE_CONVERSATION_ID="false"
# 探针专用 Agent ID（可选，未设置则使用 TBOX_AGENT_ID）
TBOX_PROBE_AGENT_ID=""
# 开放聊天入口（关闭时回滚到旧 onboarding 引导）
OPEN_CHAT_ENTRY="true"
# ── 业务 Feature Flag（安全默认值）────────────────────
# 有状态轮次服务（幂等+会话锁+两阶段事务）
STATEFUL_CHAT_TURNS="true"
# Agent Operations V1（profile_patch/memory_proposal/plan_draft 执行）
# mock 模式下安全；api 模式需等正式 AgentResponse 探针通过
AGENT_OPERATIONS_V1="false"
# Plan V2 写入（灵活周期/阶段）；关闭时仍可读取 V1/V2
PLAN_V2_WRITE="false"
# 版本化会话摘要（24条消息阈值触发）
CONVERSATION_SUMMARY="false"
TBOX_CHAT_ENDPOINT="https://o.tbox.cn/openapi/v1/chat/create"
TBOX_RETRIEVE_ENDPOINT="https://api.tbox.cn/api/datasets/retrieve"
TBOX_WS_URL="wss://o.tbox.cn/ws/chat"
TBOX_WEB_SERVICE_URL=""
TBOX_STREAM_TIMEOUT_MS="90000"

# Outer Bearer secret used by the self-hosted MCP client (minimum 32 UTF-8 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CAREERMATE_PLUGIN_TOKEN=""
# Browser Origin allow-list for MCP V2, comma separated. Server-to-server calls omit Origin.
# Example: https://b.tbox.cn,https://your-careermate.example
CAREERMATE_MCP_ALLOWED_ORIGINS=""
# Legacy static plugin/MCP binding. Agentic V2 uses CAREERMATE_CONTEXT_TOKEN_SECRET instead.
# Never accept the user id or scopes from tool arguments.
CAREERMATE_PLUGIN_USER_ID="placeholder"
CAREERMATE_PLUGIN_SCOPES="profile:read,profile:candidates,courses:read,jobs:read,progress:write"
# Server-only HMAC secret for short-lived Agentic V2 context tokens (minimum 32 UTF-8 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CAREERMATE_CONTEXT_TOKEN_SECRET=""
# Development-only escape hatch. Keep false unless intentionally testing an unconfigured plugin client.
ALLOW_UNAUTHENTICATED_PLUGIN="false"
NEXT_PUBLIC_APP_NAME="CareerMate"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
